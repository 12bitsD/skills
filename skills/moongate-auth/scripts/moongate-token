#!/usr/bin/env bash
set -euo pipefail

service="${MOONGATE_KEYCHAIN_SERVICE:-codex-moongate-access-token}"

if [[ -n "${MOONGATE_ACCESS_TOKEN:-}" ]]; then
  printf '%s' "$MOONGATE_ACCESS_TOKEN"
  exit 0
fi

if command -v security >/dev/null 2>&1; then
  token="$(security find-generic-password -a "${USER:-}" -s "$service" -w 2>/dev/null || true)"
  if [[ -n "$token" ]]; then
    printf '%s' "$token"
    exit 0
  fi
fi

cat >&2 <<EOF
No MoonGate token found.

Set MOONGATE_ACCESS_TOKEN for this shell, or store one in macOS Keychain:
  security add-generic-password -a "\$USER" -s ${service} -w

Create a personal token at: https://moongate.msh.work/tokens/create?type=personal
EOF
exit 1
